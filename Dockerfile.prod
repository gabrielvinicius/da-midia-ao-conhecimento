# Production Dockerfile for Video Summarizer
# Multi-stage build optimized for production deployment

# === Stage 1: Builder ===
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system dependencies required for building packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    pkg-config \
    libffi-dev \
    libssl-dev \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies using wheels for faster production deploy
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /app/wheels -r requirements.txt

# === Stage 2: Runtime ===
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install only runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy and install pre-built wheels from builder stage
COPY --from=builder /app/wheels /wheels
RUN pip install --no-index --find-links /wheels --no-cache-dir --no-deps --force-reinstall \
    $(ls /wheels/*.whl | xargs -n 1 basename | sed 's/\.whl$//g' | sed 's/-/==/' | sed 's/_/-/g')

# Copy application source code
COPY --chown=appuser:appuser . .

# Create necessary directories and set ownership
RUN mkdir -p /app/logs /app/media /app/storage /app/.cache/whisper /home/appuser/.cache && \
    chown -R appuser:appuser /app /home/appuser/.cache

# Switch to non-root user
USER appuser

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Production command using Gunicorn with Uvicorn worker
CMD ["gunicorn", "main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", "--timeout", "120", "--worker-tmp-dir", "/dev/shm"]
