graph TD
    subgraph "Browser"
        A[Page Component]
        B(Custom Hook e.g., useMediaDetail)
        C{React Query Cache}
        D[UI (Rendered View)]
        E(WebSocketProvider)
    end

    subgraph "Backend"
        F[API Endpoint]
        G[WebSocket Server]
    end

    A -- Calls --> B
    B -- Fetches data from --> F
    F -- Returns data --> B
    B -- Manages data in --> C
    C -- Provides data to --> A
    A -- Renders --> D

    G -- Pushes real-time update --> E
    E -- Updates cache directly --> C

    style C fill:#f9f,stroke:#333,stroke-width:2px
