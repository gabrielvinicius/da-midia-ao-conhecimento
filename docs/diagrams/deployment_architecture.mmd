graph TD
    subgraph "Public Network"
        FE[Frontend - React/Vite]
        NG[Nginx Proxy]
        API[API Backend - FastAPI]
    end

    subgraph "Backend Network (Internal)"
        WRK[Worker - Celery]
        DB[(PostgreSQL)]
        RD[Redis - Messaging/Cache]
        S3[MinIO - Object Storage]
    end

    subgraph "Intelligence Loop"
        ADV[Hardware Advisor]
        PRD[Resource Predictor]
    end

    NG --> FE
    NG --> API
    API --> RD
    API --> DB
    WRK --> RD
    WRK --> DB
    WRK --> S3
    API --> S3
    
    WRK -.-> ADV
    WRK -.-> PRD
    API -.-> ADV
    
    style FE fill:#f9f,stroke:#333
    style WRK fill:#bbf,stroke:#333
    style DB fill:#dfd,stroke:#333
    style RD fill:#fdd,stroke:#333
    style ADV fill:#ffd,stroke:#333