graph TD
    subgraph "API Layer"
        A[API Routers]
    end

    subgraph "Application Layer (Event-Driven Pipeline)"
        direction LR
        B(media_management)
        C(media_processing)
        D(text_analysis)
    end

    subgraph "Core Services"
        I(auth)
        J(notifications)
    end

    subgraph "Infrastructure Layer"
        K[Event Bus (Redis/Celery)]
        L[Database (PostgreSQL)]
        M[Storage (S3/Local)]
        N[AI Providers]
    end

    A --> B
    A --> I

    B -- Publishes MediaUploaded --> K
    C -- Consumes MediaUploaded --> K
    C -- Publishes TextContentReady --> K
    D -- Consumes TextContentReady --> K

    B -- Writes to --> L
    C -- Writes to --> L
    D -- Writes to --> L

    B -- Uses --> M
    C -- Uses --> M

    C -- Uses --> N
    D -- Uses --> N

    classDef default fill:#2D2D2D,stroke:#FFF,stroke-width:2px,color:#FFF;
