# ===============================================
#      Video Summarizer Environment Config
# ===============================================
#
# - Copy this file to .env for local development.
# - Do NOT commit the .env file to version control.

# --- PostgreSQL Database ---
DB_SCHEME=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=video_summarizer

# --- Authentication (JWT) ---
# Chave que assina os tokens de login. Obrigatória: a API não inicia com o
# valor abaixo. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Armazenamento S3 (opcional) ---
# Com um bucket definido, a opção "S3 / MinIO" aparece no envio. No
# docker-compose, o padrão é o MinIO do próprio compose (http://minio:9000).
# Na AWS, deixe STORAGE_S3_ENDPOINT_URL vazio.
STORAGE_S3_BUCKET=video-summarizer
STORAGE_S3_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minio
STORAGE_S3_SECRET_KEY=minio123

# --- LLM (Ollama) ---
# Servidor Ollama e modelos usados no resumo, nos títulos dos temas e (opcional) na visão.
# Baixe os modelos uma vez: docker compose exec ollama ollama pull qwen3.5:9b
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=qwen3.5:9b
LLM_FALLBACK_MODEL=gemma4:e4b

# Modelo de transcrição. O padrão cabe numa GPU de 12 GB ao lado do LLM;
# em máquinas sem GPU, "small" ou "medium" são bem mais rápidos.
WHISPER_MODEL=large-v3-turbo
# Janela de contexto do LLM (tokens). 16384 cabe na GPU de 12 GB junto com
# os outros modelos; a síntese divide gravações longas em blocos.
LLM_CONTEXT_TOKENS=16384
# Descrição de quadros de vídeo: "moondream" (padrão) ou "ollama"
VISUAL_PROVIDER=moondream
VISUAL_OLLAMA_MODEL=qwen3.5:9b

# Required for gated models like Llama 3
HF_TOKEN=your_huggingface_token_here

# --- Redis / Celery Broker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Rastreamento (Jaeger) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- CORS ---
# Origens do frontend aceitas pela API, separadas por vírgula.
# CORS_ORIGINS=https://resumos.exemplo.com.br

# --- Logs e métricas ---
# json (padrão, para coleta) ou console (leitura no desenvolvimento).
LOG_FORMAT=json
LOG_LEVEL=INFO
# Porta interna das métricas do Prometheus (vazia: não abre). Não é a API.
# METRICS_PORT=9100

# --- Proteção contra força bruta no login ---
# Após N falhas (por e-mail ou por IP) em USER_LOGIN_BLOCK_SECONDS, o login fica bloqueado por esse tempo.
USER_LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
USER_LOGIN_MAX_ATTEMPTS_PER_IP=20
USER_LOGIN_BLOCK_SECONDS=900

# --- Primeiro administrador ---
# Sem valor padrão: defina as duas variáveis para criar a conta na primeira
# inicialização (a senha segue as regras do cadastro). Depois, troque a senha
# pela interface e remova DEFAULT_ADMIN_PASSWORD deste arquivo.
# DEFAULT_ADMIN_FORCE_PASSWORD=1 redefine a senha de uma conta já existente.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FORCE_PASSWORD=0

# --- Mídias paradas em processamento ---
# A cada PROCESSING_STALL_CHECK_INTERVAL_SECONDS, o worker leve marca como falha
# as mídias que passaram do prazo (o usuário é avisado e pode tentar de novo).
# Prazo = duração da gravação × fator de tempo real medido nas transcrições
# anteriores × PROCESSING_STALL_SAFETY_FACTOR, entre o mínimo e o máximo.
# Sem histórico, usa PROCESSING_STALL_FALLBACK_REALTIME_FACTOR (1 = tempo real).
PROCESSING_STALL_CHECK_INTERVAL_SECONDS=300
PROCESSING_STALL_SAFETY_FACTOR=3
PROCESSING_STALL_MINIMUM_MINUTES=20
PROCESSING_STALL_MAXIMUM_HOURS=6
# Documentos, imagens e mídias cuja duração não pôde ser lida:
PROCESSING_STALL_UNKNOWN_DURATION_MINUTES=60
# Tarefa que nunca começou (fila perdida):
PROCESSING_STALL_QUEUE_HOURS=24
PROCESSING_STALL_FALLBACK_REALTIME_FACTOR=1
# Mídia enviada que não ganhou registro de processamento (API caiu no meio do
# envio, por exemplo): reenfileirada após a folga, marcada como falha após o limite.
MEDIA_UNSTARTED_CHECK_INTERVAL_SECONDS=300
MEDIA_UNSTARTED_GRACE_MINUTES=10
MEDIA_UNSTARTED_GIVE_UP_MINUTES=60
