# ===============================================
#      Video Summarizer Environment Config
# ===============================================
#
# - Copy this file to .env for local development.
# - Do NOT commit the .env file to version control.

# --- PostgreSQL Database ---
DB_SCHEME=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_summarizer

# --- Authentication (JWT) ---
# Generate a strong secret key, e.g., with: openssl rand -hex 32
SECRET_KEY=a_very_strong_and_long_secret_key_should_be_placed_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage Provider ---
# Default storage provider to use if not specified in the API request.
# Options: "local", "s3"
STORAGE_PROVIDER=local

# --- S3 / MinIO Settings (if using 's3' provider) ---
BUCKET_NAME=videos
ENDPOINT_URL=http://localhost:9000
ACCESS_KEY=minio
SECRET_KEY_S3=minio123 # Renamed to avoid conflict with auth SECRET_KEY

# --- LLM Providers (for Summarization) ---
# Default summarization provider.
# Options: "huggingface"
LLM_PROVIDER=huggingface
OPENAI_API_KEY=sk-...
TRANSFORMERS_MODEL=facebook/bart-large-cnn

# --- Redis / Celery Broker ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Video Upload Settings (Optional) ---
# Comma-separated list of allowed extensions.
# VIDEO_ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
# Max file size in megabytes.
# VIDEO_MAX_FILE_SIZE_MB=200

# --- Analytics Settings (Optional) ---
# ANALYTICS_DEFAULT_TRANSCRIPTION_FACTOR=1.0
# ANALYTICS_DEFAULT_SUMMARIZATION_SECONDS=60.0
# ANALYTICS_HIGH_CONFIDENCE_THRESHOLD=10

# --- Notification Settings (SMTP for Email) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password

# --- Observability (Jaeger for Tracing) ---
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
