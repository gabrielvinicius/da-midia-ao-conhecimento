# ===============================================
#      Da Mídia ao Conhecimento: configuração
# ===============================================
# Copie para .env (que não vai para o git) e ajuste. O docker-compose entrega
# este arquivo à API e aos workers; os endereços dos serviços (banco, Redis,
# Ollama, MinIO, Jaeger) são definidos pelo próprio compose.

# --- Banco de dados (PostgreSQL) ---
DB_SCHEME=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=app

# --- Autenticação ---
# Chave que assina os tokens de login. Obrigatória: a API não inicia com o
# valor abaixo nem com menos de 32 caracteres. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
# Validade do token de acesso (minutos) e da sessão (renovação, minutos).
# USER_ACCESS_TOKEN_EXPIRE_MINUTES=30
# USER_REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Com HTTPS (proxy reverso com certificado), ligue para o cookie da sessão
# só trafegar cifrado. Sem HTTPS, deixe desligado: o navegador o descartaria.
# USER_COOKIE_SECURE=true

# --- Proteção contra força bruta no login ---
# Após N falhas (por e-mail ou por IP) no período, o login fica bloqueado.
USER_LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
USER_LOGIN_MAX_ATTEMPTS_PER_IP=20
USER_LOGIN_BLOCK_SECONDS=900

# --- Primeiro administrador ---
# Defina as duas para criar a conta na primeira inicialização (a senha segue
# as regras do cadastro). Depois, troque a senha pela interface e apague
# DEFAULT_ADMIN_PASSWORD daqui. DEFAULT_ADMIN_FORCE_PASSWORD=1 redefine a
# senha de uma conta que já existe.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FORCE_PASSWORD=0

# --- Endereço público e e-mails da conta (opcional) ---
# Endereço pelo qual as pessoas acessam a aplicação; vai nos links dos e-mails.
PUBLIC_URL=http://localhost:3000
# Envio de e-mails: confirmação do cadastro e recuperação de senha. Sem
# SMTP_HOST, o cadastro entra direto e "Esqueci minha senha" não aparece.
# Qualquer provedor SMTP serve. Ex. (Resend): SMTP_HOST=smtp.resend.com,
# SMTP_USERNAME=resend, SMTP_PASSWORD=<chave da API>, porta 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Remetente, de um domínio verificado no provedor.
SMTP_FROM=Da Mídia ao Conhecimento <no-reply@seudominio>
# starttls (porta 587), ssl (465) ou none.
SMTP_SECURITY=starttls

# --- Publicação na internet (opcional) ---
# Cloudflare Tunnel: HTTPS sem abrir portas. Crie o túnel no painel da
# Cloudflare (Zero Trust > Networks > Tunnels), aponte o hostname público
# para http://frontend:80, cole o token abaixo e suba com
#   docker compose --profile internet up -d
# Com HTTPS, ligue também USER_COOKIE_SECURE=true e ajuste PUBLIC_URL.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Armazenamento S3 / MinIO (opcional) ---
# Com um bucket definido, a opção "S3 / MinIO" aparece no envio (o bucket é
# criado se não existir). No compose, o padrão é o MinIO dele; na AWS, deixe
# o endpoint vazio. As credenciais também definem o usuário do MinIO.
STORAGE_S3_BUCKET=media
# STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY=minio
STORAGE_S3_SECRET_KEY=troque-esta-senha-do-minio

# --- Modelos de IA ---
# Modelo de linguagem (Ollama) do resumo e dos títulos dos temas, e o reserva.
LLM_MODEL=qwen3.5:9b
LLM_FALLBACK_MODEL=gemma4:e4b
# Janela de contexto (tokens): 16384 cabe na GPU de 12 GB junto com os outros
# modelos; a síntese divide gravações longas em blocos.
LLM_CONTEXT_TOKENS=16384
# Transcrição. O padrão cabe numa GPU de 12 GB ao lado do LLM; sem GPU,
# "small" ou "medium" são bem mais rápidos.
WHISPER_MODEL=large-v3-turbo
# Glossário do domínio, separado por vírgulas: orienta a grafia dos termos
# técnicos, que são o que a transcrição mais erra. Ajuste aos cursos da
# instituição; vazio desliga.
WHISPER_HOTWORDS=engenharia de software, overengineering, underengineering, SOLID, KISS, DRY, YAGNI, Clean Code, Clean Architecture, Domain-Driven Design, linguagem ubíqua, design patterns, factory, pull request, commit, deploy, framework, backend, frontend, API, banco de dados, SQL, Python, Java, JavaScript, TypeScript, C#, Git, GitHub, Docker, microsserviços, refatoração, TDD, Scrum, Kanban, sprint
# Precisão dos modelos na GPU (o compose usa float16; int8 na CPU).
# AI_COMPUTE_TYPE=float16
# Descrição dos quadros do vídeo: ollama (o mesmo modelo do resumo, que
# aceita imagens: descreve em português e lê os textos da tela), moondream
# (mais leve, descrições curtas em inglês) ou none (desligada).
VISUAL_PROVIDER=ollama
VISUAL_OLLAMA_MODEL=qwen3.5:9b
# Fatores opcionais da análise: sentiment, topics (temas e títulos),
# grounding (verificação de fidelidade), chapters (capítulos com horário) e
# questions (perguntas de revisão). Trechos, busca, gênero e resumo sempre rodam.
ANALYSIS_FACTORS=sentiment,topics,grounding,chapters,questions
# Busca: reranqueador que ordena os trechos encontrados lendo pergunta e
# trecho juntos (roda na CPU da API, ~2 GB). Vazio: só a busca por vetores.
SEARCH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Token da Hugging Face: opcional (os modelos usados são públicos); evita o
# limite de downloads anônimos na primeira execução.
# HF_TOKEN=

# --- CORS ---
# Só para acessar a API de outra origem (desenvolvimento do frontend fora do
# compose). Pelo compose, a interface e a API têm a mesma origem.
# CORS_ORIGINS=https://resumos.exemplo.com.br

# --- Logs ---
# json (padrão, para coleta) ou console (leitura no desenvolvimento).
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Prazos do processamento ---
# A cada intervalo, o worker leve marca como falha (o usuário é avisado e pode
# tentar de novo) as transcrições que passaram do prazo: duração da gravação ×
# tempo por segundo de gravação medido nas anteriores × fator de folga, entre
# o mínimo e o máximo. Sem histórico, usa o fator padrão (1 = tempo real).
PROCESSING_STALL_CHECK_INTERVAL_SECONDS=300
PROCESSING_STALL_SAFETY_FACTOR=3
PROCESSING_STALL_MINIMUM_MINUTES=20
PROCESSING_STALL_MAXIMUM_HOURS=6
# Documentos, imagens e mídias cuja duração não pôde ser lida:
PROCESSING_STALL_UNKNOWN_DURATION_MINUTES=60
# Tarefa que nunca começou (fila perdida):
PROCESSING_STALL_QUEUE_HOURS=24
PROCESSING_STALL_FALLBACK_REALTIME_FACTOR=1
# Mídia enviada que não ganhou registro de processamento (a API caiu no meio
# do envio, por exemplo): anunciada de novo após a folga e marcada como falha
# após o limite.
MEDIA_UNSTARTED_CHECK_INTERVAL_SECONDS=300
MEDIA_UNSTARTED_GRACE_MINUTES=10
MEDIA_UNSTARTED_GIVE_UP_MINUTES=60
# Análise: tempo máximo de uma tentativa no worker, e o prazo após o qual a
# mídia "em análise" é dada como falha (deve ser maior que o anterior).
ANALYSIS_TIME_LIMIT_MINUTES=150
MEDIA_ANALYSIS_GIVE_UP_MINUTES=180

# --- Fora do Docker (desenvolvimento local) ---
# Sem o compose, aponte para os serviços na própria máquina:
# DATABASE_URL=postgresql+asyncpg://postgres:troque-esta-senha@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# OLLAMA_HOST=http://localhost:11434
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# APP_ENV=development
