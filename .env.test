# ===============================================
#      Test Environment Config
# ===============================================
#
# This file is used by docker-compose.test.yml for E2E testing.

# --- PostgreSQL Test Database ---
# The host name matches the service name in docker-compose.test.yml
DB_SCHEME=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres-test
DB_PORT=5432
DB_NAME=test_db

# --- Authentication (JWT) ---
SECRET_KEY=a_test_secret_key_that_is_secure_enough_for_testing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5

# --- Storage Provider ---
# Use the local provider for E2E tests as it requires no external setup.
STORAGE_PROVIDER=local

# --- Redis / Celery Broker for Tests ---
# The host name matches the service name in docker-compose.test.yml
REDIS_HOST=redis-test
REDIS_PORT=6379
REDIS_DB=1 # Use a different DB number for isolation
REDIS_URL=redis://redis-test:6379/1
CELERY_BROKER_URL=redis://redis-test:6379/1

# --- Other settings can be omitted as they will use defaults ---
